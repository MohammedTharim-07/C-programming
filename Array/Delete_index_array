#include<stdio.h>

int main()
{
    int arr[5];
    int limit = 5;
    int pos;


    for(int i=0; i<limit; i++)
    {
        printf("Enter element: ");
        scanf("%d", &arr[i]);
    }

    printf("Enter position to delete : ");
    scanf("%d", &pos);

    pos = pos - 1;


    for(int i=pos; i<limit-1; i++)
    {
        arr[i] = arr[i+1];
    }

    limit--;

    for(int i=0; i<limit; i++)
    {
        printf("%d ", arr[i]);
    }

    return 0;
}
