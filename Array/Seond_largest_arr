 #include <stdio.h>

int main()
{
    int arr[5] = {10, 45, 78, 23, 11};
    int i;
    int largest, second;

    largest = arr[0];

    /* Find largest */
    for(i = 1; i < 5; i++)
    {
        if(arr[i] > largest)
        {
            largest = arr[i];
        }
    }

    second = arr[0];

    /* Find second largest */
    for(i = 1; i < 5; i++)
    {
        if(arr[i] > second && arr[i] != largest)
        {
            second = arr[i];
        }
    }

    printf("Second Largest = %d", second);

    return 0;
}
