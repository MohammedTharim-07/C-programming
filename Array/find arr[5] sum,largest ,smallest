    int largest;
    int smallest;

    for(int i = 0; i < 5; i++)
    {
        printf("Enter number %d: ", i+1);
        scanf("%d", &arr[i]);
    }
    largest =arr[0];
    smallest=arr[0];

    for(int i = 0; i < 5; i++)
    {
        sum += arr[i];
    
    if(arr[i]>largest)
    {
        largest=arr[i];
    }
    else if(arr[i]>smallest)
    {
        smallest=smallest;
    }
}
 printf("Sum = %d\n", sum);
    printf("largest number:%d\n",largest);
