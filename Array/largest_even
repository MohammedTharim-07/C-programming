#include<stdio.h>

int main()
{
    int arr[5];
    int largest = -1;   // no even found yet

    // input
    for(int i=0;i<5;i++)
    {
        printf("Enter num %d: ", i+1);
        scanf("%d",&arr[i]);
    }

    // process
    for(int i=0;i<5;i++)
    {
        if(arr[i] % 2 == 0)        // check even
        {
            if(arr[i] > largest)   // compare
            {
                largest = arr[i];  // update
            }
        }
    }

    // output
    if(largest == -1)
        printf("No even number");
    else
        printf("Largest even = %d", largest);

    return 0;
}
