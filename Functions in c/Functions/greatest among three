#include<stdio.h>
int greatest(int a,int b,int c)
{
   /*return (a>b)?a:b;*/
   
   if(a>=b && a>=c)
   {
       return a;
   }
   else if(b>=a && b>=c)
   {
       return b;
   }
   else 
   {
       return c;
   }
}
int main()
{
    int result;
    result=greatest(10,40,50);
    printf("Greatest=%d",result);
    return 0;
}
