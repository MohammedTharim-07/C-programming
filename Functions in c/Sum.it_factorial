#include <stdio.h>

//add
int add(int a, int b)
{
    return a + b;
}

// Function
int factorial(int n)
{
    int fact = 1;
    int i = 1;

    while(i <= n)
    {
        fact = fact * i;
        i++;
    }

    return fact;
}

int main()
{
    int num1, num2, sum, result;

    printf("Enter two numbers: ");
    scanf("%d %d", &num1, &num2);

    sum = add(num1, num2);
    result = factorial(sum);

    printf("Sum = %d\n", sum);
    printf("Factorial of sum = %d\n", result);

    return 0;
}
