#include <stdio.h>
int factorial(int n)
{
    int fact = 1;
    int i = 1;

    while(i <= n)
    {
        fact = fact * i;
        i++;
    }

    return fact;
}
void check(int num)
{
    if(num % 2 == 0)
    {
        printf("Even number\n");
    }
    else
    {
        int result = factorial(num);
        printf("Odd number\n");
        printf("Factorial = %d\n", result);
    }
}

int main()
{
    int num;

    printf("Enter number: ");
    scanf("%d", &num);

    check(num);

    return 0;
}
