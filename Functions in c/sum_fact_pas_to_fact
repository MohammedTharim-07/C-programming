#include <stdio.h>

// Function
int factorial(int n)
{
    int fact = 1;
    int i = 1;

    while(i <= n)
    {
        fact = fact * i;
        i++;
    }

    return fact;
}

// Function
void add(int a, int b)
{
    int sum = a + b;
    printf("sum=%d",sum);

    int result = factorial(sum);

    printf("Factorial of sum = %d", result);
}

int main()
{
    int num1, num2;

    printf("Enter two numbers: ");
    scanf("%d %d", &num1, &num2);

    add(num1, num2);

    return 0;
}
