#include <stdio.h>

int main()
{
    int a[] = {5, 12, 18, 23, 31, 42, 56, 70, 85};
    int data = 23;

    int n = sizeof(a) / sizeof(a[0]);

    int l = 0;
    int r = n - 1;
    int mid;

    while(l <= r)
    {
        mid = (l + r) / 2;

        if(data == a[mid])
        {
            printf("Element found at index %d", mid);
            return 0;
        }
        else if(data < a[mid])
        {
            r = mid - 1;
        }
        else
        {
            l = mid + 1;
        }
    }

    printf("Element not found");

    return 0;
}
