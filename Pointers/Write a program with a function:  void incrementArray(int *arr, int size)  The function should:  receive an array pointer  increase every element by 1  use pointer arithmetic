#include<stdio.h>

void incrementArray(int *arr, int size)
{
    for(int i = 0; i < size; i++)
    {
        *(arr + i) = *(arr + i) + 1;
    }
}

int main()
{
    int arr[5] = {1,2,3,4,5};

    incrementArray(arr,5);

    for(int i = 0; i < 5; i++)
    {
        printf("%d\n", *(arr + i));
    }

    return 0;
}




