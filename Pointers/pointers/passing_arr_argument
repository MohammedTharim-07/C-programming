#include <stdio.h>

void Arr_print(double *arr);

int main()
{
    double bal[3] = {1000.0, 2.0, 3.4};

    Arr_print(bal);

    return 0;
}

void Arr_print(double *arr)
{
    int i;

    printf("Array values are\n");

    for(i = 0; i < 3; i++)
    {
        printf("value %lf\n", *(arr + i));
    }
}
