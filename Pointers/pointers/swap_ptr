#include<stdio.h>
int main()
{
int num1,num2;
printf("enter the number 1:");
scanf("%d",&num1);

printf("Enter the number 2:");
scanf("%d",&num2);
int *p1;
int *p2;
int *temp;
p1=&num1;
p2=&num2;
temp=p1;
p1=p2;
p2=temp;

printf("After swap num 1 is :%d",p1);
printf("\nAfter swap num 2 is :%d",p2);
return 0;
}
