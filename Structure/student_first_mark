#include<stdio.h>
struct student
{
int Reg_No;
char name[30];
float mark;
};

int main()
{
struct student s[3];

for(int i=0;i<3;i++)
{
printf("\nEnter student %d Details\n",i+1);

printf("Enter the reg_no:");
scanf("%d",&s[i].Reg_No);

printf("Enter the name:");
scanf("%s",&s[i].name);

printf("Enter the mark:");
scanf("%f",&s[i].mark);
}

printf("\nStudent details\n:");

for(int i=0;i<3;i++)
{
printf("\nStudent%d\n",i+1);


printf("Reg_no=%d\n",s[i].Reg_No);
printf("Name=%s\n",s[i].name);
printf("Mark=%.2f\n",s[i].mark);

}
printf("\n");
if(s[0].mark>s[1].mark && s[0].mark>s[2].mark)
{
    printf("School first :\n Reg_No=%d\n Name=%s\n" ,s[0].Reg_No,s[0].name);
}
else if(s[1].mark>s[0].mark && s[1].mark>s[2].mark)
{
    printf("School first: Reg_No= %d\n Name=%s\n" ,s[1].Reg_No,s[1].name);
}
else if(s[2].mark>s[0].mark && s[2].mark>s[1].mark)
{
    printf("School first: Reg_No=%d\n Name=%s\n",s[2].Reg_No,s[2].name);
}



return 0;



}

