#include<stdio.h>
int main()
{
        int ignition;
        int consecutive_on=0;
    for(int i=1;i<=10;i++)
{
    printf("cycle %d -Enter igniton (1-on, 0-off):",i);
    scanf("%d",&ignition);
    if(ignition==1)
    {
        consecutive_on++;
        if(consecutive_on==3)
        {
        printf("warning: continuos ignition\n");
        
    }
    }
    else
    {
    consecutive_on=0;
    }
}
    return 0;
}
