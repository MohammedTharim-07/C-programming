#include <stdio.h>

int main()
{
    int number;
    int positive = 0;
    int negative = 0;
    int zero = 0;

    for(int i = 1; i <= 10; i++)
    {
        printf("Enter number %d: ", i);
        scanf("%d", &number);

        if(number > 0)
        {
            positive++;
        }
        else if(number < 0)
        {
            negative++;
        }
        else
        {
            zero++;
        }
    }

    printf("Positive = %d\n", positive);
    printf("Negative = %d\n", negative);
    printf("Zero = %d\n", zero);

    return 0;
}
