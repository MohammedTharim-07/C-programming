#include <stdio.h>

int main() {
    int i, j;

    // Top part
    for(i = 5; i >0; i--) {
        for(j = 1; j <= i; j++) {
            printf("*");
        }
        printf("\n");
    }

    // Bottom part
    for(int i=2;i<=5;i++)
    {
        for(int j=1;j<=i;j++)
        {
            printf("*");
        }
        printf("\n");
    }

    return 0;
}
