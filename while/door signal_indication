#include <stdio.h>

int main()
{
    int door_signal;

    int open_count = 0;
    int close_count = 0;

    int door_state = 0;        // 0 = closed, 1 = open
    int stuck_warning = 0;     // 0 = no stuck, 1 = stuck active

    int stuck_event_count = 0; // how many times stuck occurred
    int service_required = 0;  // service lock

    while(1)
    {
        printf("Door signal (-1 to stop): ");
        scanf("%d", &door_signal);

        if(door_signal == -1)
        {
            break;
        }

        if(door_signal == 1)
        {
            open_count++;
            close_count = 0;

            // Confirm Open
            if(open_count >= 4 && door_state == 0)
            {
                printf("Door Confirmed Open\n");
                door_state = 1;
            }

            // Stuck Activate
            if(open_count >= 10 && stuck_warning == 0)
            {
                printf("Door Stuck Warning\n");
                stuck_warning = 1;

                stuck_event_count++;

                if(stuck_event_count >= 3 && service_required == 0)
                {
                    printf("Service Required\n");
                    service_required = 1;
                }
            }
        }
        else if(door_signal == 0)
        {
            close_count++;
            open_count = 0;

            // Confirm Closed
            if(close_count >= 5 && door_state == 1)
            {
                printf("Door Confirmed Closed\n");
                door_state = 0;
            }

            // Stuck Clear
            if(close_count >= 5 && stuck_warning == 1)
            {
                printf("Door Stuck Cleared\n");
                stuck_warning = 0;
            }
        }
    }

    return 0;
}
